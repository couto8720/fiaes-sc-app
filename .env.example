# Copia este ficheiro para .env.local e preenche com os valores do teu projeto Supabase
# (Project Settings → API Keys / Data API).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# Só no servidor (para enviar convites ao staff). NUNCA com prefixo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Segredo da tarefa automática que evita a pausa do Supabase gratuito (/api/manter-ativo).
# Gera um valor aleatório comprido e põe-no também nas variáveis do projeto na Vercel.
CRON_SECRET=

# Endereço público do site, usado nos links dos emails (em desenvolvimento pode ficar vazio).
SITE_URL=
